NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Calendly — prise de rendez-vous instantanée sur /demande-demo. Sans valeur, le formulaire
# de contact reste le seul moyen de demander une démo.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-slug

# Analytics respectueux du RGPD (au choix, un seul suffit). Sans l'un des deux, aucun script
# n'est chargé — pas besoin de bannière cookies supplémentaire.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=immopilot.world
NEXT_PUBLIC_FATHOM_SITE_ID=ABCDEFGH

# Service role Supabase (secret, jamais exposé au client) — nécessaire pour inviter des coéquipiers
# et pour les routes de facturation Stripe. À trouver dans Supabase > Project Settings > API.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe — nécessaire pour la facturation par abonnement (Réglages > Abonnement)
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRICE_STARTER=price_your-starter-price-id
STRIPE_PRICE_PRO=price_your-pro-price-id
STRIPE_PRICE_AGENCE=price_your-agence-price-id

# Resend — envoi des emails transactionnels (messages IA, nouvelle candidature, nouveau document).
# Sans clé, les emails sont simplement journalisés en console (mode dégradé).
RESEND_API_KEY=your-resend-api-key
RESEND_FROM=ImmoPilot <notifications@votre-domaine.fr>

# Claude (Anthropic) — moteur des fonctionnalités IA réelles : qualification des prospects,
# synthèse de dossier, assistant conversationnel, rédaction/relances assistées.
# Sans clé, chaque fonctionnalité bascule automatiquement sur son repli local (règles), la démo
# reste donc toujours fonctionnelle. À trouver sur console.anthropic.com.
ANTHROPIC_API_KEY=your-anthropic-api-key
